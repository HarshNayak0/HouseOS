# Copy to .env.local for local runs. In production these live in Vercel → Project → Settings → Environment Variables.
# Never commit real values. Only NEXT_PUBLIC_* values are sent to the browser.

# --- Supabase (phase 2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (phase 2) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Google OAuth + Calendar (phase 2 / 4) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts Google refresh tokens at rest.
TOKEN_ENCRYPTION_KEY=

# --- Vault (phase 7) --- 32 random bytes, base64
VAULT_MASTER_KEY=

# --- Recipe import (phase 6) ---
GEMINI_API_KEY=
GROQ_API_KEY=
# Fine-grained GitHub token, this repo only, "Actions: read and write" — triggers the import workflow
GITHUB_DISPATCH_TOKEN=
