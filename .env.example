# The web app's variables. Copy to .env.local for local runs; in production they live in
# Vercel → Project → Settings → Environment Variables. Never commit real values.
# Only NEXT_PUBLIC_* values are sent to the browser.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Web Push ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Not here on purpose: the Edge Functions' secrets (GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
# TOKEN_ENCRYPTION_KEY, GEMINI_API_KEY, VAULT_MASTER_KEY, VAPID_*) are GitHub Secrets. The
# "Deploy Supabase functions" workflow copies them into Supabase. See README → GitHub Secrets.
